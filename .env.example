PORT=3011
NODE_ENV=development

# The API Gateway validates the user JWT and forwards trusted claims.
API_GATEWAY_SECRET=replace-with-a-long-random-gateway-secret

# Dedicated MySQL schema/database for Booking.
BOOKING_MYSQL_HOST=127.0.0.1
BOOKING_MYSQL_PORT=3306
BOOKING_MYSQL_USER=petcare_booking
BOOKING_MYSQL_PASSWORD=change-me
BOOKING_MYSQL_DATABASE=petcare_booking
BOOKING_MYSQL_SSL=DISABLED
BOOKING_MYSQL_SSL_CA=
TYPEORM_LOGGING=false
BOOKING_EXPIRATION_POLL_MS=60000

# CQRS read model. Keep false until the read schema is migrated.
BOOKING_READ_MODEL_ENABLED=false
BOOKING_READ_MODEL_READS_ENABLED=false
BOOKING_READ_MYSQL_HOST=127.0.0.1
BOOKING_READ_MYSQL_PORT=3306
BOOKING_READ_MYSQL_USER=petcare_booking
BOOKING_READ_MYSQL_PASSWORD=change-me
BOOKING_READ_MYSQL_DATABASE=petcare_booking_read
BOOKING_READ_QUERY_MYSQL_USER=petcare_booking
BOOKING_READ_QUERY_MYSQL_PASSWORD=change-me
BOOKING_READ_MYSQL_SSL=DISABLED
BOOKING_READ_MYSQL_SSL_CA=
BOOKING_EVENT_OUTBOX_POLL_MS=1000
BOOKING_EVENT_OUTBOX_MAX_ATTEMPTS=10
BOOKING_PROJECTION_MAX_RETRIES=5

# Local booking-context projection in the existing Booking read database.
BOOKING_CONTEXT_PROJECTION_ENABLED=false
BOOKING_CONTEXT_HTTP_FALLBACK_ENABLED=false
RABBITMQ_BOOKING_CONTEXT_QUEUE=booking-service.context-projection
RABBITMQ_BOOKING_CONTEXT_DLQ=booking-service.context-projection.dlq
PETCARE_BOOKING_CONTEXT_SNAPSHOT_PATH=/internal/booking-context/snapshots

# Public API browser origin and internal calls to the PetCare services.
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
PETCARE_BACKEND_URL=http://localhost:3005/api
PETCARE_SERVICE_SECRET=replace-with-the-same-long-service-secret

# RabbitMQ shared with the orchestration service.
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_EXCHANGE=petcare.events
RABBITMQ_DEAD_LETTER_EXCHANGE=petcare.events.dead
RABBITMQ_BOOKING_QUEUE=booking-service.commands
RABBITMQ_BOOKING_DLQ=booking-service.commands.dlq
RABBITMQ_BOOKING_READ_QUEUE=booking-service.read-model
RABBITMQ_BOOKING_READ_DLQ=booking-service.read-model.dlq

# Shared-secret calls from the backend provider service.
BOOKING_INTERNAL_SECRET=replace-with-a-long-internal-secret
